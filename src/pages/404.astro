---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Seite nicht gefunden"
	description="Diese Seite gibt es nicht mehr. Von hier geht es zurück zur Startseite von Carina Hillenbrand."
	noindex
>
	<h1 class="font-display text-4xl font-extrabold tracking-[-0.03em] sm:text-5xl">
		Seite nicht gefunden
	</h1>
	<p class="mt-6 text-cream/70">
		Diese Seite existiert nicht (mehr).
		<a
			href="/"
			class="text-accent-light underline underline-offset-4 transition hover:text-cream"
		>
			Zur Startseite
		</a>
	</p>
</BaseLayout>
