---
import { NAV, SITE } from '../consts';

const current = Astro.url.pathname;
---

<header class="border-b border-cream/12">
	<div class="mx-auto flex max-w-[1100px] items-center justify-between px-6 py-6 sm:px-10 lg:px-14">
		<a
			href="/"
			class="font-display text-lg font-extrabold tracking-[-0.02em] transition hover:text-accent-light"
		>
			{SITE.title}
		</a>
		{NAV.length > 1 && (
			<nav aria-label="Hauptnavigation">
				<ul class="flex gap-6 font-display text-sm font-semibold">
					{NAV.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={current === item.href ? 'page' : undefined}
								class="text-cream/55 transition hover:text-cream aria-[current=page]:text-accent-light"
							>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)}
	</div>
</header>
