---
import type { ImageMetadata } from 'astro';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import { SITE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	/** Eigenes Vorschaubild beim Teilen — ohne Angabe nimmt SEO.astro das Standardbild. */
	image?: ImageMetadata;
	imageAlt?: string;
	/** Ohne schmale Textspalte: für Seiten mit eigenen, vollbreiten Abschnitten (Startseite). */
	wide?: boolean;
}

const {
	title,
	description,
	noindex,
	image,
	imageAlt,
	wide = false,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<SEO
			title={title}
			description={description}
			noindex={noindex}
			image={image}
			imageAlt={imageAlt}
		/>
		<!-- Seiten mit eigenem Kopf-Inhalt, z. B. JSON-LD. -->
		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col overflow-x-hidden">
		<Header />
		{wide ? (
			<main class="flex-1">
				<slot />
			</main>
		) : (
			<main class="mx-auto w-full max-w-3xl flex-1 px-6 py-16 sm:px-10">
				<slot />
			</main>
		)}
		<Footer />
	</body>
</html>
